# Copy to .env and fill in. docker-compose reads this automatically.
# The api service refuses to start in Production if the three secrets are unset.

# --- Required secrets ---
SIA_JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
SIA_ADMIN_PASSWORD=change-me
ZEPCAM_API_KEY=change-me

# --- Optional ---
# AES-256 key for SIA encryption (32 ASCII chars). Leave blank for unencrypted.
SIA_ENCRYPTION_KEY=
# n8n webhook that fans out the out-of-band alert when an alarm is dead-lettered.
# Treat as a secret — the alert body carries identity + live GPS.
ALERT_WEBHOOK_URL=
# Durable dead-letter directory (mounted volume in Docker).
SIA_DEAD_LETTER_DIR=/app/data/dead-letters

# --- SIA receiver (override appsettings.json defaults) ---
SIA_RECEIVER_IP=10.33.26.190
SIA_RECEIVER_PORT=55001
SIA_ACCOUNT_NUMBER=A001
SIA_RECEIVER_NUMBER=R0
SIA_ACCOUNT_PREFIX=L0
SIA_EVENT_CODE=NPA
